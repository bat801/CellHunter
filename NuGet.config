<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep NuGet restore data inside the workspace instead of
         %USERPROFILE%\.nuget and %LOCALAPPDATA%\NuGet. Relative paths are
         resolved from this file, so every worktree gets its own cache. -->
    <add key="globalPackagesFolder" value=".cache/nuget/packages" />
  </config>
</configuration>

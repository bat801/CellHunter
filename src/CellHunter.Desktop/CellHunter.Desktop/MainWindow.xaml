<Window x:Class="CellHunter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CellHunter.Desktop.Utils"
        mc:Ignorable="d"
        Title="CellHunter - AI Cell Detection" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="🧬 CellHunter" FontSize="28" FontWeight="Bold" 
                   Foreground="#4CAF50" Margin="0,0,0,10"/>

        <!-- Панель управления -->
        <Border Grid.Row="1" Background="#2D2D44" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="📁 Выбрать папку" Grid.Column="0" Padding="12,8" 
                        Command="{Binding SelectFolderCommand}"
                        Background="#3D3D5C" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1" Text="{Binding SelectedFolder}" 
                           Foreground="#AAAAAA" VerticalAlignment="Center" 
                           TextTrimming="CharacterEllipsis"/>

                <Button Content="▶ Запуск" Grid.Column="2" Padding="20,8" Margin="0,0,5,0"
                        Command="{Binding StartAnalysisCommand}"
                        Background="#4CAF50" Foreground="#dbdbdb" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand"/>

                <ComboBox Grid.Column="3" Width="120" Margin="0,0,5,0"
                        ItemsSource="{Binding AvailableModels}"
                        SelectedItem="{Binding SelectedModel}"
                        Background="#3D3D5C" Foreground="#dbdbdb" 
                        BorderThickness="0" FontWeight="Bold">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#3D3D5C"/>
                                    <Setter Property="Foreground" Value="#dbdbdb"/>
                                </Style>
                            </ComboBox.Resources>
                </ComboBox>

                <Button Content="⏹ Отмена" Grid.Column="4" Padding="15,8" Margin="0,0,10,0"
                        Command="{Binding CancelAnalysisCommand}"
                        Background="#E74C3C" Foreground="#dbdbdb" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand"/>

                <Button Content="📊 Excel" Grid.Column="5" Padding="15,8"
                        Command="{Binding ExportReportCommand}"
                        Background="#3498DB" Foreground="#dbdbdb" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Прогресс-бар -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <ProgressBar Value="{Binding ProgressValue}" Height="20" 
                         Background="#2D2D44" Foreground="#4CAF50" 
                         BorderThickness="0" Minimum="0" Maximum="100"/>
            <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="White" FontWeight="SemiBold"/>
        </Grid>

        <!-- Основное содержимое: Логи + Таблица -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Логи -->
            <Border Background="#2D2D44" CornerRadius="8" Padding="10">
                <ScrollViewer>
                    <TextBox Text="{Binding LogMessages}" Foreground="#00FF41" 
                             Background="Transparent" FontFamily="Consolas" FontSize="12" 
                             TextWrapping="Wrap" VerticalAlignment="Top"
                             IsReadOnly="True" BorderThickness="0"/>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" Background="Transparent" 
                           ResizeBehavior="BasedOnAlignment"/>

            <!-- Таблица результатов -->
            <Border Grid.Column="2" Background="#2D2D44" CornerRadius="8" Padding="10">
                <DataGrid ItemsSource="{Binding Results}" 
                          AutoGenerateColumns="False" 
                          Background="Transparent" 
                          Foreground="White" 
                          RowBackground="#3D3D5C"
                          AlternatingRowBackground="#2D2D44"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#4A4A6A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Height" Value="30"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Файл" Binding="{Binding Filename}" Width="*"/>
                        <DataGridTextColumn Header="Ядра" Binding="{Binding Count}" Width="60"/>
                        <DataGridTextColumn Header="Ширина" Binding="{Binding Width}" Width="60"/>
                        <DataGridTextColumn Header="Высота" Binding="{Binding Height}" Width="60"/>
                        <DataGridTextColumn Header="Время, с" Binding="{Binding TimeSeconds, StringFormat={}{0:F1}}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Статус-бар -->
        <Border Grid.Row="4" Background="#2D2D44" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <TextBlock Foreground="#AAAAAA">
                <Run Text="Статус: "/>
                <Run Text="{Binding IsAnalyzing, Converter={StaticResource BoolToStatus}}"/>
                <Run Text=" | "/>
                <Run Text="Результатов: "/>
                <Run Text="{Binding Results.Count, Mode=OneWay}"/>
            </TextBlock>
        </Border>
    </Grid>
</Window>